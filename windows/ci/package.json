{
  "schemaVersion": 1,
  "distribution": "dll-sql",
  "files": [
    {
      "source": "upstream",
      "path": "pg_qualstats.dll",
      "destination": "lib/pg_qualstats.dll",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "pg_qualstats.control",
      "destination": "share/extension/pg_qualstats.control",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "pg_qualstats--*.sql",
      "destination": "share/extension/{fileName}",
      "targets": ["install", "zip"],
      "expectedCount": 11
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": ["zip"]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": ["zip"]
    }
  ],
  "packageInfo": [
    "pg_qualstats Windows binary package",
    "===================================",
    "",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref:        {upstreamRef}",
    "Upstream commit:     {upstreamCommit}",
    "pg_qualstats version:{version}",
    "PostgreSQL major:    {pgMajor}",
    "PostgreSQL tested:   {pgTested}",
    "Architecture:        {architecture}",
    "Compiler:            MSVC",
    "License:             PostgreSQL-style; see LICENSE",
    "",
    "This is an unofficial pgextwin Windows package built from the official pg_qualstats source.",
    "For server-wide collection, load pg_qualstats through shared_preload_libraries."
  ]
}
